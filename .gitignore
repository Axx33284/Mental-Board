node_modules/

# package-lock.json is deliberately NOT ignored. Both dependencies are caret
# ranges, so without the lockfile a fresh clone resolves whatever Electron 31.x
# is current that day — and this app leans on specific Chromium behaviour:
# document.execCommand, variable-font weight resolution, webUtils.getPathForFile.
# One copy, one path, one known toolchain.

# the runnable app, written by admin\Build App.cmd — always rebuilt, never edited
App/
# where the build stages before it replaces App\
.build/
# the setup file tools/build-setup.js writes (npm run setup)
dist/

# the throwaway profile `npm run sandbox` writes to, and the copies the
# admin pack's backup script drops next to itself
.sandbox*/
.sandbox.log
admin/backups/
